{
  "name": "Showcase",
  "description": "No cursor: slow glides and a final overview, like a product reel.",
  "resetOthers": true,
  "pace": 0.9,
  "dishes": {
    "camera": {
      "on": true,
      "easing": 1.8,
      "zoom": 1
    },
    "overview": {
      "on": true,
      "duration": 2,
      "pad": 0.1,
      "hold": 2
    },
    "cursor": {
      "on": false
    },
    "typing": {
      "on": true,
      "cps": 16,
      "caret": false
    },
    "captions": {
      "on": true,
      "style": "headline",
      "position": "top",
      "size": 40,
      "color": "auto",
      "fade": 0.6
    },
    "background": {
      "on": true,
      "style": "mesh",
      "color1": "#F3E3CC",
      "color2": "#E6DAF2",
      "padding": 0.1,
      "radius": 22,
      "shadow": 0.6
    },
    "transitions": {
      "on": true,
      "style": "fade",
      "duration": 0.8
    },
    "fades": {
      "on": true,
      "color": "#FBFAF7",
      "in": 0.8,
      "out": 1
    }
  }
}
